{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "skillloop",
	"main": "src/index.js",
	"compatibility_date": "2026-10-28",
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": true
	},
	// D1 数据库 ID 为占位符。部署前运行 `wrangler d1 create <name>`，
	// 并把返回的真实 database_id 填入下方对应项。
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "skillloop-db",
			"database_id": "00000000-0000-0000-0000-000000000000"
		},
		{
			"binding": "DEMO_DB",
			"database_name": "skillloop-demo-db",
			"database_id": "00000000-0000-0000-0000-000000000000"
		}
	],
	"observability": {
		"enabled": true
	}
}